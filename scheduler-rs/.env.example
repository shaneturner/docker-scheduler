# Logging Level for tracing crate (e.g., trace, debug, info, warn, error)
RUST_LOG=info

# Timezone for the scheduler (e.g., UTC, Europe/London, America/New_York)
SCHEDULER_TIMEZONE=UTC

# How often (in minutes) the scheduler rescans Docker for label changes
SCHEDULE_INTERVAL_MINUTES=1

# Default timeout (in seconds) for executing docker compose commands
COMMAND_TIMEOUT_SECONDS=600

# Optional: Docker context to use (passed to `docker --context ...`)
# DOCKER_CONTEXT=default

# Optional: Explicit Docker Compose project name (passed to `docker compose -p ...`)
# COMPOSE_PROJECT_NAME=synctest

# Note: DOCKER_SOCKET_PATH is usually handled by the volume mount, not env var here.
